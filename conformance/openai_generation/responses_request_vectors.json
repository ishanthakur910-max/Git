{
  "accepted": [
    {
      "name": "string defaults",
      "body": {"model": "m", "input": "Tell me a joke"},
      "expected": {
        "model": "m",
        "prompt": "Tell me a joke",
        "messages": null,
        "max_output_tokens": 16,
        "temperature": null,
        "top_p": null,
        "seed": null
      }
    },
    {
      "name": "developer and text parts",
      "body": {
        "model": "m",
        "input": [
          {"role": "developer", "content": "Be concise"},
          {
            "role": "user",
            "content": [
              {"type": "input_text", "text": "Hi "},
              {"type": "text", "text": "there"}
            ]
          }
        ],
        "stream": false
      },
      "expected": {
        "model": "m",
        "prompt": null,
        "messages": [
          {"role": "system", "content": "Be concise"},
          {"role": "user", "content": "Hi there"}
        ],
        "max_output_tokens": 16,
        "temperature": null,
        "top_p": null,
        "seed": null
      }
    },
    {
      "name": "sampling overrides",
      "body": {
        "model": "m",
        "input": "x",
        "max_output_tokens": 32,
        "temperature": 0.25,
        "top_p": 0.8,
        "seed": -1
      },
      "expected": {
        "model": "m",
        "prompt": "x",
        "messages": null,
        "max_output_tokens": 32,
        "temperature": 0.25,
        "top_p": 0.8,
        "seed": -1
      }
    }
  ],
  "rejected": [
    {
      "name": "known unsupported tools",
      "body": {"model": "m", "input": "x", "tools": []},
      "param": "tools",
      "code": "unsupported_field"
    },
    {
      "name": "unknown top-level field",
      "body": {"model": "m", "input": "x", "foo": true},
      "param": "foo",
      "code": "unsupported_field"
    },
    {
      "name": "empty message array",
      "body": {"model": "m", "input": []},
      "param": "input",
      "code": "invalid_request"
    },
    {
      "name": "unknown message field",
      "body": {"model": "m", "input": [{"role": "user", "content": "x", "name": "caller"}]},
      "param": "input[0].name",
      "code": "unsupported_field"
    },
    {
      "name": "unknown content-part field",
      "body": {
        "model": "m",
        "input": [{"role": "user", "content": [{"type": "input_text", "text": "x", "foo": true}]}]
      },
      "param": "input[0].content[0].foo",
      "code": "unsupported_field"
    },
    {
      "name": "non-text content part",
      "body": {
        "model": "m",
        "input": [{"role": "user", "content": [{"type": "input_image", "text": "x"}]}]
      },
      "param": "input[0].content[0].type",
      "code": "unsupported_field"
    },
    {
      "name": "missing role",
      "body": {"model": "m", "input": [{"content": "x"}]},
      "param": "input[0].role",
      "code": "invalid_request"
    },
    {
      "name": "tool role without tool-output support",
      "body": {"model": "m", "input": [{"role": "tool", "content": "x"}]},
      "param": "input[0].role",
      "code": "invalid_request"
    },
    {
      "name": "streaming unsupported",
      "body": {"model": "m", "input": "x", "stream": true},
      "param": "stream",
      "code": "unsupported_field"
    },
    {
      "name": "stream type",
      "body": {"model": "m", "input": "x", "stream": "false"},
      "param": "stream",
      "code": "invalid_request"
    },
    {
      "name": "zero top p",
      "body": {"model": "m", "input": "x", "top_p": 0},
      "param": "top_p",
      "code": "invalid_request"
    },
    {
      "name": "temperature exceeds runtime precision",
      "body": {"model": "m", "input": "x", "temperature": 1e100},
      "param": "temperature",
      "code": "invalid_request"
    },
    {
      "name": "seed outside signed i64",
      "body": {"model": "m", "input": "x", "seed": 9223372036854775808},
      "param": "seed",
      "code": "invalid_request"
    },
    {
      "name": "invalid output cap",
      "body": {"model": "m", "input": "x", "max_output_tokens": 0},
      "param": "max_output_tokens",
      "code": "invalid_request"
    }
  ]
}
